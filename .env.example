# Copy to .env and adjust. Every value is optional.

# --- server ---
TP_HOST=0.0.0.0
TP_PORT=8080
# Access token for the web app / API. Strongly recommended if the server is reachable by others.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(24))"
TP_TOKEN=
TP_DATA_DIR=data
# Set to 1 when served over HTTPS (reverse proxy) so the session cookie is Secure
TP_COOKIE_SECURE=0

# --- printer connection ---
# ble = real printer, mock = saves PNGs to data/mock_prints (no hardware needed)
TP_BACKEND=ble
# Leave empty to auto-discover by name; set to pin a specific printer (Linux/Win: MAC, macOS: UUID)
TP_PRINTER_ADDRESS=
TP_PRINTER_NAME=SC03h
# Seconds to keep the BLE link after the last job (0 = stay connected)
TP_IDLE_DISCONNECT=120
TP_CHUNK_SIZE=180
TP_CHUNK_DELAY=0.01
TP_HOLD_AFTER=3

# --- default print tuning (also editable in the app under Printer) ---
TP_WIDTH=384
TP_ENERGY=17520
TP_QUALITY=0x33
TP_SPEED=0x23
TP_DRAW_MODE=0x00
TP_FEED=90
TP_FEED_MODE=a1
TP_ENCODING=raw-lsb
TP_MIRROR=0
# Pull the post-print feed back (0xA0) before the next print, so a roll left in the
# printer gets tasks one after another without gaps
TP_REWIND=1
# Print upside down so text reads the right way up as it leaves the printer
TP_ROTATE180=1

# --- misc ---
TP_MAX_ROWS=6000
TP_MAX_UPLOAD_MB=15
# Custom TTF fonts
TP_FONT=
TP_FONT_BOLD=
